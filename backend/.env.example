# Copy this file to .env (same folder) and fill in your values.
# .env is ignored by git — never commit real keys.

AWS_ACCESS_KEY_ID=paste-access-key-here
AWS_SECRET_ACCESS_KEY=paste-secret-key-here
AWS_REGION=us-east-1
AI_PROVIDER=bedrock
BEDROCK_MODEL_ID=us.amazon.nova-lite-v1:0

# Optional
# STORE=dynamo
# SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:crewlog-alerts
# DEFAULT_TZ=Asia/Kolkata
